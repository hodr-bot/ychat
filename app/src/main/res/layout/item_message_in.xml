<?xml version="1.0" encoding="utf-8"?>
<!-- YChat original resource (GPL-3.0). Created from scratch. No third-party code copied. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="start"
    android:orientation="vertical"
    android:padding="4dp">

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="start"
        android:background="@drawable/ychat_bg_bubble_in"
        android:orientation="vertical"
        android:padding="10dp">

        <TextView
            android:id="@+id/ychat_msg_text_in"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/ychat_text_primary"
            android:textSize="15sp" />

        <TextView
            android:id="@+id/ychat_msg_time_in"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="end"
            android:textColor="@color/ychat_text_secondary"
            android:textSize="11sp" />

    </LinearLayout>

</LinearLayout>
