<?xml version="1.0" encoding="utf-8"?>
<!-- YChat original resource (GPL-3.0). Created from scratch. No third-party code copied. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/ychat_bg"
    android:orientation="vertical">

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/ychat_message_list"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:padding="8dp"
        android:scrollbars="vertical" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/ychat_surface"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="8dp">

        <EditText
            android:id="@+id/ychat_input"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:background="@drawable/ychat_bg_input_bar"
            android:hint="@string/MessageInputHint"
            android:inputType="textMultiLine|textCapSentences"
            android:maxLines="4"
            android:padding="12dp"
            android:textColor="@color/ychat_text_primary"
            android:textColorHint="@color/ychat_text_secondary"
            android:textCursorDrawable="@drawable/ychat_cursor_blue" />

        <ImageButton
            android:id="@+id/ychat_btn_send"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginStart="8dp"
            android:background="@drawable/ychat_bg_avatar_circle"
            android:contentDescription="@string/MessageSend"
            android:padding="12dp"
            android:src="@drawable/ychat_ic_send_24" />

    </LinearLayout>

</LinearLayout>
